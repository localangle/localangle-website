---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import BackfieldCarousel from "../../components/BackfieldCarousel.astro";
import { getPosts, formatDate } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const showBackfieldCarousel = post.data.carousel === "backfield";
const shareImage = showBackfieldCarousel
  ? {
      image: "/images/backfield/og.png",
      imageWidth: 1200,
      imageHeight: 627,
      imageAlt:
        "Agate flow builder connecting article input to entity extraction, geocoding, metadata and JSON output",
    }
  : {};
---
<Base title={post.data.title} description={post.data.description} {...shareImage}>
  <article class="prose">
    <header>
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        <strong class="byline">Chase Davis</strong>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      </p>
    </header>
    {showBackfieldCarousel && <BackfieldCarousel class="post-carousel" />}
    <Content />
  </article>
</Base>

<style>
  .prose :global(.post-carousel) {
    margin: 0 0 2.4rem;
  }
</style>
