---
interface Slide {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption: string;
}

const slides: Slide[] = [
  {
    src: "/images/backfield/carousel-1.png",
    alt: "Agate flow builder connecting article input to entity extraction, geocoding, metadata and JSON output",
    width: 1800,
    height: 895,
    caption: "Build custom extraction and enrichment workflows in Agate.",
  },
  {
    src: "/images/backfield/carousel-2.png",
    alt: "Agate places review interface showing highlighted source evidence beside a map and geocoded locations",
    width: 1800,
    height: 903,
    caption: "Review and geocode extracted places.",
  },
  {
    src: "/images/backfield/carousel-3.png",
    alt: "Agate people review interface showing article evidence and extracted people with roles and affiliations",
    width: 1800,
    height: 891,
    caption: "Inspect people, their roles, quotes and supporting evidence.",
  },
  {
    src: "/images/backfield/carousel-4.png",
    alt: "Stylebook geography interface showing a maintained neighborhood boundary on a map of Chicago",
    width: 1800,
    height: 904,
    caption: "Maintain canonical entities, geography and connections in Stylebook.",
  },
  {
    src: "/images/backfield/carousel-6.png",
    alt: "Stylebook connections interface showing a network graph of people and organizations linked to a single person",
    width: 1800,
    height: 930,
    caption: "See how people and organizations connect across your coverage.",
  },
  {
    src: "/images/backfield/carousel-5.png",
    alt: "API Playground showing geographic search of locations with a bounding box on a map",
    width: 1800,
    height: 872,
    caption: "Explore and query structured coverage data through the Backfield API.",
  },
];

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section
  class:list={["product-carousel", className]}
  data-carousel
  aria-label="Backfield product screenshots"
  aria-roledescription="carousel"
>
  <div class="carousel-stage">
    {
      slides.map((slide, index) => (
        <figure
          class:list={["carousel-slide", { "is-active": index === 0 }]}
          data-carousel-slide
          aria-hidden={index === 0 ? "false" : "true"}
          hidden={index !== 0}
        >
          <img
            src={slide.src}
            alt={slide.alt}
            width={slide.width}
            height={slide.height}
            loading={index === 0 ? undefined : "lazy"}
          />
          <figcaption>{slide.caption}</figcaption>
        </figure>
      ))
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    if (carousel.dataset.carouselReady === "true") return;
    carousel.dataset.carouselReady = "true";

    const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-carousel-slide]"));
    const stage = carousel.querySelector<HTMLElement>(".carousel-stage");
    const rotationDelay = 4000;
    let active = 0;
    let rotationTimer: number | undefined;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const showSlide = (index: number) => {
      active = (index + slides.length) % slides.length;

      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === active;
        slide.classList.toggle("is-active", isActive);
        slide.setAttribute("aria-hidden", String(!isActive));
      });
    };

    const stopRotation = () => {
      window.clearTimeout(rotationTimer);
      rotationTimer = undefined;
    };

    const startRotation = () => {
      stopRotation();
      if (reducedMotion || document.hidden) return;
      rotationTimer = window.setTimeout(() => {
        showSlide(active + 1);
        startRotation();
      }, rotationDelay);
    };

    document.addEventListener("visibilitychange", startRotation);

    slides.forEach((slide) => {
      slide.hidden = false;
    });
    stage?.classList.add("is-ready");
    showSlide(0);
    startRotation();
  });
</script>

<style>
  .product-carousel {
    width: 100%;
    margin: 0 auto 2.5rem;
  }

  .carousel-stage.is-ready {
    display: grid;
  }

  .carousel-slide {
    margin: 0;
  }

  .carousel-slide[hidden] {
    display: none;
  }

  .carousel-stage.is-ready .carousel-slide {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.65rem) scale(0.992);
    transition:
      opacity 650ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 650ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 650ms;
    will-change: opacity, transform;
  }

  .carousel-stage.is-ready .carousel-slide.is-active {
    z-index: 1;
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
    transition-delay: 0s;
  }

  .carousel-slide img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 0.35rem;
  }

  .carousel-slide figcaption {
    margin-top: 0.6rem;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-stage.is-ready .carousel-slide {
      transform: none;
      transition: none;
    }
  }
</style>
