---
import "@fontsource-variable/source-serif-4";
import "@fontsource-variable/source-serif-4/wght-italic.css";
import "../styles/global.css";
import Mark from "../components/Mark.astro";

interface Props {
  title?: string;
  description?: string;
  /** Path under /public, e.g. /images/backfield/carousel-1.png */
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
}

const {
  title,
  description = "Local Angle is a consultancy and product lab that helps news organizations apply emerging technologies in ways that align with journalistic values.",
  image,
  imageWidth,
  imageHeight,
  imageAlt,
} = Astro.props;

const pageTitle = title ? `${title} — Local Angle` : "Local Angle";
const path = Astro.url.pathname;
const isBackfield = path.startsWith("/backfield");
const isBlog = path.startsWith("/blog");
const isWork = path.startsWith("/work-with-us");

const site = Astro.site ?? new URL("https://localangle.co");
const pageUrl = new URL(Astro.url.pathname, site).href;
const absoluteImage = image
  ? new URL(`${import.meta.env.BASE_URL}${image.replace(/^\//, "")}`, site).href
  : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Local Angle" href="/rss.xml" />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    {absoluteImage && (
      <>
        <meta property="og:image" content={absoluteImage} />
        {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
        {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
        {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={absoluteImage} />
        {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
      </>
    )}
  </head>
  <body>
    <header class="site frame">
      <div class="row">
        <a class="brand" href="/">
          <Mark size={20} />
          <span>Local Angle</span>
        </a>
        <nav class="site">
          <a href="/backfield" aria-current={isBackfield ? "page" : undefined}>Backfield</a>
          <a href="/blog" aria-current={isBlog ? "page" : undefined}>Blog</a>
          <a href="/work-with-us" aria-current={isWork ? "page" : undefined}>Work with us</a>
        </nav>
      </div>
    </header>
    <main class="frame">
      <slot />
    </main>
    <footer class="site frame">
      <div class="row">
        <span>&copy; {new Date().getFullYear()} Local Angle</span>
        <span><a href="/rss.xml">RSS</a></span>
      </div>
    </footer>
  </body>
</html>
